# Production values are configured in Sites runtime settings, never committed.
# Exact verified email of the Site owner's ChatGPT account. Initial sign-in
# binds its stable per-Site user ID; later access checks use only that binding.
GULLAK_MANAGE_OWNER_EMAIL=
# Mark true only after Search Console confirms the exact production property.
# This records setup status; it does not import Google's performance data.
GULLAK_SEARCH_CONSOLE_VERIFIED=false
# Optional connected AI service; built-in Gullie works without this.
OPENAI_API_KEY=
